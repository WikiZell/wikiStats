# ---- Node / web ----
node_modules/
web/dist/
web/.vite/

# Generated LittleFS payload. Built from web/ with `npm run build`; committing it
# would mean two sources of truth for the same bytes.
firmware/data/www/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Secrets: never commit ----
# Real deployment configs may contain API tokens, Wi-Fi and MQTT passwords.
config.toml
!agent/packaging/config.example.toml
secrets.ini
*.pem
*.key
!shared/*.json
backup-*.json
